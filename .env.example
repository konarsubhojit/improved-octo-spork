PROCESS_ROLE=api
PORT=3000
TRUSTED_ORIGIN=https://reminders.example.com
PUBLIC_BASE_URL=https://reminders.example.com
ORACLE_USER=app_api
ORACLE_PASSWORD=replace-with-secret-from-private-secret-store
ORACLE_CONNECT_STRING=example_high
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# Only for PROCESS_ROLE=email-worker:
GMAIL_USER=sender@example.com
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
# Optional: use 465 for SMTPS, default 587 STARTTLS.
GMAIL_PORT=587
# Remains false: outbound probe execution intentionally fails closed.
PROBE_EXECUTION_ENABLED=false
