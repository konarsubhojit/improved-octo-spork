{
  "name": "reminders-service-monitor",
  "version": "0.2.0",
  "description": "Invite-only reminders and two-way service monitoring MVP",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:core": "tsx --test tests/core.test.ts",
    "typecheck": "tsc --noEmit",
    "start:api": "tsx src/runtime/api.ts",
    "start:scheduler": "tsx src/runtime/scheduler.ts",
    "start:email-worker": "tsx src/runtime/email-worker.ts",
    "migrate": "tsx src/runtime/migrate.ts",
    "inspect:schema": "node --env-file=.env --import tsx src/runtime/inspect-schema.ts",
    "bootstrap": "tsx src/runtime/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.0.1",
    "oracledb": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/oracledb": "^7.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
